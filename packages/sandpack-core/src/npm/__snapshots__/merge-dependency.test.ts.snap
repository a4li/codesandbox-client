    select: function (context, from, to) {
      var nodeVersions = jsReleases.filter(function (i) {
        return i.name === 'nodejs'
      }).map(function (i) {
        return i.version
      })
      var semverRegExp = /^(0|[1-9]\\\\d*)(\\\\.(0|[1-9]\\\\d*)){0,2}$/
      if (!semverRegExp.test(from)) {
        throw new BrowserslistError(
