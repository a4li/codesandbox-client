  _instanceof: createKeyword(\\"instanceof\\", {
    beforeExpr,
    binop: 7
  }),
  _typeof: createKeyword(\\"typeof\\", {
    beforeExpr,
    prefix,
    startsExpr
  }),
  _void: createKeyword(\\"void\\", {
    beforeExpr,
    prefix,
    startsExpr
  }),
  _delete: createKeyword(\\"delete\\", {
    beforeExpr,
    prefix,
    startsExpr
