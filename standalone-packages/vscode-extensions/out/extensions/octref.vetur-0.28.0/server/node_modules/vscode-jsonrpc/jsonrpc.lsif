{"id":62127,"type":"edge","label":"next","outV":62126,"inV":62123}
{"id":62128,"type":"vertex","label":"hoverResult","result":{"contents":[{"language":"typescript","value":"(method) AbstractWorker.addEventListener<K extends \"error\">(type: K, listener: (this: AbstractWorker, ev: AbstractWorkerEventMap[K]) => any, options?: boolean | AddEventListenerOptions | undefined): void (+1 overload)"}]}}
{"id":62129,"type":"edge","label":"textDocument/hover","outV":62123,"inV":62128}
{"id":62130,"type":"vertex","label":"range","start":{"line":632,"character":4},"end":{"line":632,"character":20},"tag":{"type":"definition","text":"addEventListener","kind":7,"fullRange":{"start":{"line":632,"character":4},"end":{"line":632,"character":132}}}}
